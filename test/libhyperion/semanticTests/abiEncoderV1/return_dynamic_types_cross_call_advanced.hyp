contract C {
	function dyn() public returns (bytes memory a, uint b, bytes48[] memory c, uint d) {
		a = "1234567890123456789012345678901234567890";
		b = type(uint).max;
		c = new bytes48[](4);
		c[0] = bytes48(uint384(1234));
		c[3] = bytes48(uint384(6789));
		d = 0x1234;
	}
	function f() public returns (bytes memory, uint, bytes48[] memory, uint) {
		return this.dyn();
	}
}
