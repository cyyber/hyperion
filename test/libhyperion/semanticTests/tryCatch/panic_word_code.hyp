contract C {
    function g(uint a, uint b) public pure returns (uint) {
        return a / b;
    }
    function f(uint a, uint b) public returns (uint) {
        try this.g(a, b) returns (uint v) {
            return v;
        } catch Panic(uint code) {
            return code;
        } catch {
            return 0xbad;
        }
    }
}
// ----
// g(uint512,uint512): 6, 3 -> 2
// g(uint512,uint512): 6, 0 -> FAILURE, hex"df75fb3b", 0x12
// f(uint512,uint512): 6, 3 -> 2
// f(uint512,uint512): 6, 0 -> 0x12
