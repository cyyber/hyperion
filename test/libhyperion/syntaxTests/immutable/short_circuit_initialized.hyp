contract AndBranch {
    uint immutable x;
    constructor(bool condition) {
        condition && ((x = 1) == 1);
    }
}

contract OrBranch {
    uint immutable x;
    constructor(bool condition) {
        condition || ((x = 1) == 1);
    }
}

