contract C {
    uint8 immutable public a;
    uint8 immutable public b = 0x42;
    uint public c;

    constructor() {
        delete a;
        delete b;
        c = b * 2 + a;
    }
}
// ----
// TypeError 3969: (135-136): Immutable variables must be initialized using an assignment.
// TypeError 2718: (153-154): Immutable variables cannot be modified after initialization.
