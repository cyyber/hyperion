contract TrueBranch {
    uint immutable x;
    constructor(bool condition) {
        condition ? (x = 1) : uint(0);
    }
}

contract FalseBranch {
    uint immutable x;
    constructor(bool condition) {
        condition ? uint(0) : (x = 1);
    }
}

