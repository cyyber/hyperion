contract Init {
    uint immutable x;

    constructor() {
        for (x = 1; false;) {}
    }
}

contract Condition {
    uint immutable x;

    constructor() {
        for (; (x = 1) == 1;) {}
    }
}

contract Post {
    uint immutable x;

    constructor() {
        for (; false; x = 1) {}
    }
}

contract Body {
    uint immutable x;

    constructor() {
        for (; false;) {
            x = 1;
        }
    }
}
